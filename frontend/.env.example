# Copy this file to .env.local. Use the same three LiveKit values as the agent's .env.
# They stay on the server: only app/api/token/route.ts reads them.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: the agent's name, if you changed it with LIVEKIT_AGENT_NAME in the agent's .env.
# Defaults to simli-agent.
LIVEKIT_AGENT_NAME=
