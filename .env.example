# Copy this file to .env and fill it in.

# From https://app.simli.com (API key in your profile).
SIMLI_API_KEY=

# From your LiveKit Cloud project's settings (https://cloud.livekit.io), or a
# self-hosted LiveKit server with a public address: Simli's servers join the room.
# Copy the same three values to frontend/.env.local.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# From https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional: any Trinity-2 face ID. Defaults to Simli's default Trinity-2 face,
# 14c60d62-6ebf-424d-b626-1f4f91c33b04 (a woman: keep a female voice in agent.py).
SIMLI_FACE_ID=

# Optional: the name the agent registers under. Defaults to simli-agent. If you change it,
# set the same LIVEKIT_AGENT_NAME in frontend/.env.local.
LIVEKIT_AGENT_NAME=
