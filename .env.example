# Copy this file to .env and fill it in.

# From https://app.simli.com (API key in your profile).
SIMLI_API_KEY=

# From your LiveKit Cloud project (https://cloud.livekit.io): Settings > API keys, then
# Create key (the secret is shown once). The free Build plan is enough.
# These also pay for the speech-to-text, LLM and text-to-speech models, through LiveKit
# Inference: no OpenAI or other model keys. Inference needs LiveKit Cloud, so a
# self-hosted LiveKit server won't run this agent as is.
# Copy the same three values to frontend/.env.local.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: any Trinity-2 face ID. Defaults to Simli's default Trinity-2 face,
# 14c60d62-6ebf-424d-b626-1f4f91c33b04 (a woman: keep a female voice in agent.py).
SIMLI_FACE_ID=

# Optional: the name the agent registers under. Defaults to simli-agent. If you change it,
# set the same LIVEKIT_AGENT_NAME in frontend/.env.local.
LIVEKIT_AGENT_NAME=
