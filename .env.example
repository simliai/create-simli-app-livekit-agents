# Copy this file to .env and fill it in.

# From https://app.simli.com (API key in your profile).
SIMLI_API_KEY=

# From your LiveKit Cloud project's settings (https://cloud.livekit.io), or any
# LiveKit server that Simli's servers can reach over the internet.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# From https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional: any Trinity-2 face ID. Defaults to the preset bf13113a-355a-4d97-8b90-4edccd1da7b2.
SIMLI_FACE_ID=
